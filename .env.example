# ---------- Agent service ----------
PORT=8787
HOST=127.0.0.1
DEPLOYMENT_MODE=local

# ---------- Solana (devnet only) ----------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------- Agent wallet ----------
AGENT_ID=agent-001
AGENT_DATA_DIR=./data
# Encrypts the agent keypair at rest. Devnet demo only.
AGENT_KEYSTORE_PASSPHRASE=nexus-devnet-demo-passphrase
# Encrypts audit log payloads at rest.
AUDIT_ENCRYPTION_PASSPHRASE=nexus-devnet-demo-audit-key

# ---------- Owner ----------
# Pin the owner wallet. Empty = the first Phantom wallet that connects is bound,
# and any later wallet can take over (fine for a local demo, not for a server).
OWNER_PUBKEY=

# Browser session signing (local default is only for local development).
SESSION_COOKIE_SECRET=local-dev-session-cookie-secret-change-me
AUTH_SESSION_TTL_SECONDS=1800

# ---------- Model pipeline ----------
# auto = use a provider when its key is set, otherwise the deterministic parser
# mock = never call a provider
MODEL_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=2048
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Web ----------
# Dashboard origin. Local mode permits local origins; hosted mode requires one
# HTTPS origin and signed Phantom login sessions.
WEB_ORIGIN=http://localhost:5173

# For hosted mode set DEPLOYMENT_MODE=hosted, OWNER_PUBKEY, WEB_ORIGIN=https://your-domain,
# and replace SESSION_COOKIE_SECRET plus both encryption passphrases with separate random values.
