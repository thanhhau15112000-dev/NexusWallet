# ---------- Agent service ----------
PORT=8787
HOST=127.0.0.1
DEPLOYMENT_MODE=local

# ---------- Solana (devnet only) ----------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------- Agent wallet ----------
AGENT_ID=agent-001
AGENT_DATA_DIR=./data
# Encrypts the agent keypair at rest. Devnet demo only.
AGENT_KEYSTORE_PASSPHRASE=nexus-devnet-demo-passphrase
# Encrypts audit log payloads at rest.
AUDIT_ENCRYPTION_PASSPHRASE=nexus-devnet-demo-audit-key

# ---------- Multi-tenant & Admin ----------
# Recognized admin wallet pubkey. Required in hosted mode: left empty, no wallet is admin and
# legacy single-tenant state is not migrated. Local mode falls back to the built-in demo admin.
ADMIN_PUBKEY=
# Legacy alias for ADMIN_PUBKEY (optional).
OWNER_PUBKEY=
# Optional whitelist of allowed Phantom pubkeys (comma-separated). Empty = public demo (all allowed).
ALLOWED_OWNERS=

# Browser session signing (local default is only for local development).
SESSION_COOKIE_SECRET=local-dev-session-cookie-secret-change-me
AUTH_SESSION_TTL_SECONDS=1800

# ---------- Model pipeline ----------
# auto = use a provider when its key is set, otherwise the deterministic parser
# mock = never call a provider
MODEL_MODE=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------- Task Vault ----------
# Base URL of the demo merchant (demo-merchant Worker). When set, the merchant can be the
# worker of an on-chain task: it delivers the output and co-signs the settlement that pays it.
MERCHANT_WORKER_URL=

# ---------- Web ----------
# Dashboard origin. Local mode permits local origins; hosted mode requires one
# HTTPS origin and signed Phantom login sessions.
WEB_ORIGIN=http://localhost:5173

# ---------- Telegram notifications (optional) ----------
# Token from @BotFather; leave empty to disable Telegram alerts.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (optional; resolved via getMe if left empty).
TELEGRAM_BOT_USERNAME=
# Secret header for hosted webhook verification (16-256 chars of A-Za-z0-9_-).
# Derived from SESSION_COOKIE_SECRET when omitted.
TELEGRAM_WEBHOOK_SECRET=

# For hosted mode set DEPLOYMENT_MODE=hosted, ADMIN_PUBKEY (or legacy OWNER_PUBKEY),
# WEB_ORIGIN=https://your-domain, and replace SESSION_COOKIE_SECRET plus both encryption
# passphrases with separate random values. ALLOWED_OWNERS is optional; empty allows any wallet.
